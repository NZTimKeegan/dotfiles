{
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "dev-team@bfinster": true,
    "marketplace-dev@bfinster": true,
    "security-assessment@bfinster": true
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse)",
      "Bash(git status)",
      "Bash(mise run *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.*.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "dark-ansi",
  "worktree": {
    "baseRef": "head"
  }
}
