{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.*.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "dev-team@bfinster": true,
    "marketplace-dev@bfinster": true,
    "security-assessment@bfinster": true
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "editorMode": "vim"
}
