{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(curl http://0.0.0.0:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl http://[::1]:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl https://0.0.0.0:*)",
      "Bash(curl https://127.0.0.1:*)",
      "Bash(curl https://[::1]:*)",
      "Bash(curl https://localhost:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(git rev-parse)",
      "Bash(git status)",
      "Bash(mise run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.*.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "model": "opus",
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "dev-team@bfinster": true,
    "marketplace-dev@bfinster": true,
    "security-assessment@bfinster": true,
    "timetabling@timetabling-plugin": true
  },
  "extraKnownMarketplaces": {
    "timetabling-plugin": {
      "source": {
        "source": "directory",
        "path": "/Users/tim.keegan/Code/Data-Engineering/timetabling-plugin"
      }
    }
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "agentPushNotifEnabled": true
}
